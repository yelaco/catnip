<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Catnip</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #0d0d0f;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      font-family: 'Segoe UI', system-ui, sans-serif;
      color: #e8e8e8;
      user-select: none;
    }

    h1 {
      font-size: 1.1rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: #a0a0b0;
      margin-bottom: 12px;
      font-weight: 400;
    }

    canvas {
      display: block;
      border-radius: 6px;
      cursor: crosshair;
      /* CSS dimensions; actual backing store is scaled by dpr */
      width: 1000px;
      height: 700px;
    }
  </style>
</head>
<body>
  <h1>Catnip — don't miss.</h1>
  <canvas id="game"></canvas>

  <script>
    // ─── Constants ────────────────────────────────────────────────────────────
    const W = 1000;
    const H = 700;
    const CAT_RADIUS = 24;
    const BALL_RADIUS = 8;
    const CAT_INITIAL_SPEED = 180;
    const CAT_SPEED_MULTIPLIER = 1.18;
    const CAT_MAX_SPEED = 540;
    const BALL_MAX_SPEED = 700;
    const BALL_MAX_DRAG = 200;
    const BALL_MIN_DRAG = 20;
    const BALL_DECAY_EARLY = 0.92;    // gentle decay for first 3 wall bounces
    const BALL_DECAY_LATE  = 0.55;    // sharp decay after 3rd wall bounce
    const BALL_MIN_SPEED = 80;        // px/s — ball removed when slower than this
    const GUIDE_MAX_BOUNCES = 5;      // trajectory preview shows up to 5 bounces
    const INITIAL_BALLS = 5;
    const BALLS_PER_HIT = 2;
    const WALL_THICKNESS = 8;
    const THROWER_X = W / 2;
    const THROWER_Y = H / 2;
    const THROWER_RADIUS = 18;

    // ─── Canvas setup ─────────────────────────────────────────────────────────
    const canvas = document.getElementById('game');
    const ctx = canvas.getContext('2d');
    const dpr = window.devicePixelRatio || 1;

    // Set backing-store size
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    // Scale all drawing calls
    ctx.scale(dpr, dpr);

    function randomRange(min, max) {
      return min + Math.random() * (max - min);
    }

    // ─── Game State ───────────────────────────────────────────────────────────

    const GameState = {
      MENU: 'menu',
      PLAYING: 'playing',
      SETTINGS: 'settings',
      GUIDE: 'guide',
    };

    let currentState = GameState.MENU;

    let cat, activeBalls, score, ballsRemaining, gameOver;
    let drag = null; // { x, y } of pointerdown start
    let dragCurrent = null;
    let catHitFlash = 0;
    let guideDashOffset = 0;
    let comboPopups = [];
    let particles = [];   // burst particles on cat hit
    let screenShake = 0;  // px magnitude, decays per frame
    let audioCtx = null;  // Web Audio API context, initialized on first interaction
    let masterGain = null;
    let isMuted = JSON.parse(localStorage.getItem('catnip_muted') ?? 'false');

    // ─── Menu State ───────────────────────────────────────────────────────────
    let menuFocusIndex = 0;    // keyboard nav focus (0-3)
    let menuHoverIndex = -1;   // pointer hover index
    let menuButtons = [];      // populated by drawMenu / buildMenuButtons

    function buildMenuButtons() {
      const btnW = 260;
      const btnH = 62;
      const gap = 78;
      const labels = ['Play Game', 'Settings', 'Guide'];
      const totalH = (labels.length - 1) * gap + btnH;
      const startY = H / 2 - totalH / 2 - 20;
      menuButtons = labels.map((label, i) => ({
        label,
        x: W / 2 - btnW / 2,
        y: startY + i * gap,
        w: btnW,
        h: btnH,
        index: i,
      }));
    }

    // Back buttons for settings/guide screens
    let backButtonRect = { x: W / 2 - 80, y: H - 100, w: 160, h: 52 };
    let backHover = false;
    let muteBtnHover = false;
    const muteBtnRect = { x: W - 48, y: 10, w: 36, h: 36 };
    // Starfield: static set of twinkling bg dots
    const STAR_COUNT = 18;
    const STAR_COLORS = ['#00f5ff','#ff00ff','#ffff00','#ff8c00','#00ff88','#bf5fff'];
    const stars = Array.from({ length: STAR_COUNT }, () => ({
      x: randomRange(0, W),
      y: randomRange(0, H),
      r: randomRange(0.8, 2.2),
      phase: randomRange(0, Math.PI * 2),
      speed: randomRange(0.6, 1.8),
      color: STAR_COLORS[Math.floor(Math.random() * STAR_COLORS.length)],
    }));

    function resetGame() {
      const angle = randomRange(0, Math.PI * 2);
      cat = {
        x: randomRange(CAT_RADIUS + 10, W - CAT_RADIUS - 10),
        y: randomRange(CAT_RADIUS + 10, H / 3),
        vx: Math.cos(angle) * CAT_INITIAL_SPEED,
        vy: Math.sin(angle) * CAT_INITIAL_SPEED,
        speed: CAT_INITIAL_SPEED,
        r: CAT_RADIUS,
      };
      activeBalls = [];
      score = 0;
      ballsRemaining = INITIAL_BALLS;
      gameOver = false;
      catHitFlash = 0;
      comboPopups = [];
      particles = [];
      screenShake = 0;
    }

    // ─── Drawing helpers ──────────────────────────────────────────────────────

    function drawCat(c) {
      const { x, y, r } = c;

      ctx.save();

      // Colorful outer glow ring (before body)
      const glowGrd = ctx.createRadialGradient(x, y, r, x, y, r * 1.8);
      glowGrd.addColorStop(0, 'rgba(255,200,80,0.18)');
      glowGrd.addColorStop(1, 'rgba(255,200,80,0)');
      ctx.fillStyle = glowGrd;
      ctx.beginPath();
      ctx.arc(x, y, r * 1.8, 0, Math.PI * 2);
      ctx.fill();

      // Pulsing glow
      const pulseBlur = 14 + Math.sin(Date.now() * 0.003) * 6;
      ctx.shadowBlur = pulseBlur;
      ctx.shadowColor = `hsl(${30 + 20 * Math.sin(Date.now() * 0.002)}, 90%, 65%)`;

      // Body
      ctx.beginPath();
      ctx.arc(x, y, r, 0, Math.PI * 2);
      ctx.fillStyle = '#e8a84a';
      ctx.fill();
      ctx.strokeStyle = '#c07830';
      ctx.lineWidth = 2;
      ctx.stroke();

      // Ears (two triangles)
      const earW = r * 0.55;
      const earH = r * 0.75;
      ctx.fillStyle = '#e8a84a';
      ctx.strokeStyle = '#c07830';
      ctx.lineWidth = 1.5;
      // Left ear
      ctx.beginPath();
      ctx.moveTo(x - r * 0.45, y - r * 0.72);
      ctx.lineTo(x - r * 0.45 - earW, y - r * 0.72 - earH);
      ctx.lineTo(x - r * 0.05, y - r * 0.82);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();
      // Right ear
      ctx.beginPath();
      ctx.moveTo(x + r * 0.45, y - r * 0.72);
      ctx.lineTo(x + r * 0.45 + earW, y - r * 0.72 - earH);
      ctx.lineTo(x + r * 0.05, y - r * 0.82);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();

      // Inner ear pink
      ctx.fillStyle = '#ff80c0';
      ctx.beginPath();
      ctx.moveTo(x - r * 0.42, y - r * 0.76);
      ctx.lineTo(x - r * 0.42 - earW * 0.55, y - r * 0.76 - earH * 0.55);
      ctx.lineTo(x - r * 0.08, y - r * 0.84);
      ctx.closePath();
      ctx.fill();
      ctx.beginPath();
      ctx.moveTo(x + r * 0.42, y - r * 0.76);
      ctx.lineTo(x + r * 0.42 + earW * 0.55, y - r * 0.76 - earH * 0.55);
      ctx.lineTo(x + r * 0.08, y - r * 0.84);
      ctx.closePath();
      ctx.fill();

      // Eyes
      ctx.fillStyle = '#1a1a2e';
      ctx.beginPath();
      ctx.ellipse(x - r * 0.3, y - r * 0.1, r * 0.18, r * 0.22, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.beginPath();
      ctx.ellipse(x + r * 0.3, y - r * 0.1, r * 0.18, r * 0.22, 0, 0, Math.PI * 2);
      ctx.fill();

      // Eye shine
      ctx.fillStyle = 'rgba(255,255,255,0.7)';
      ctx.beginPath();
      ctx.arc(x - r * 0.24, y - r * 0.18, r * 0.07, 0, Math.PI * 2);
      ctx.fill();
      ctx.beginPath();
      ctx.arc(x + r * 0.36, y - r * 0.18, r * 0.07, 0, Math.PI * 2);
      ctx.fill();

      // Nose
      ctx.fillStyle = '#ff6090';
      ctx.beginPath();
      ctx.moveTo(x, y + r * 0.12);
      ctx.lineTo(x - r * 0.1, y + r * 0.22);
      ctx.lineTo(x + r * 0.1, y + r * 0.22);
      ctx.closePath();
      ctx.fill();

      // Whiskers
      ctx.strokeStyle = 'rgba(255,255,255,0.6)';
      ctx.lineWidth = 1;
      for (let s of [-1, 1]) {
        ctx.beginPath();
        ctx.moveTo(x + s * r * 0.1, y + r * 0.18);
        ctx.lineTo(x + s * r * 0.9, y + r * 0.1);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(x + s * r * 0.1, y + r * 0.22);
        ctx.lineTo(x + s * r * 0.9, y + r * 0.25);
        ctx.stroke();
      }

      // Hit flash overlay
      if (catHitFlash > 0) {
        ctx.shadowBlur = 0;
        ctx.globalAlpha = (catHitFlash / 0.3) * 0.6;
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fill();
        ctx.globalAlpha = 1;
      }

      ctx.restore();
    }

    function drawBall(b) {
      const ballColors = ['#4ade80','#38bdf8','#a78bfa','#f472b6','#fb923c'];
      const ballStrokeColors = ['#16a34a','#0369a1','#7c3aed','#be185d','#c2410c'];
      const ballColor = ballColors[Math.min(b.bounces, ballColors.length - 1)];
      const ballStroke = ballStrokeColors[Math.min(b.bounces, ballStrokeColors.length - 1)];

      // Trail: fading circles behind the ball
      if (b.trail && b.trail.length > 0) {
        for (let i = 0; i < b.trail.length; i++) {
          const t = b.trail[i];
          const frac = (i + 1) / b.trail.length; // 0 (oldest) → 1 (newest)
          const alpha = frac * 0.35;
          const radius = BALL_RADIUS * (0.35 + frac * 0.55);
          ctx.save();
          ctx.globalAlpha = alpha;
          ctx.beginPath();
          ctx.arc(t.x, t.y, radius, 0, Math.PI * 2);
          ctx.fillStyle = ballColor;
          ctx.fill();
          ctx.restore();
        }
      }

      ctx.save();
      ctx.shadowBlur = 18;
      ctx.shadowColor = ballColor;
      ctx.beginPath();
      ctx.arc(b.x, b.y, BALL_RADIUS, 0, Math.PI * 2);
      ctx.fillStyle = ballColor;
      ctx.fill();
      ctx.strokeStyle = ballStroke;
      ctx.lineWidth = 1.5;
      ctx.stroke();
      ctx.restore();
      // Small sparkle
      ctx.fillStyle = 'rgba(255,255,255,0.6)';
      ctx.beginPath();
      ctx.arc(b.x - 2, b.y - 2, 2, 0, Math.PI * 2);
      ctx.fill();
    }

    function drawThrower() {
      ctx.save();
      // Platform
      ctx.shadowBlur = 8;
      ctx.shadowColor = '#6366f1';
      ctx.fillStyle = '#1e1b4b';
      ctx.beginPath();
      ctx.roundRect(THROWER_X - 40, THROWER_Y - 6, 80, 14, 7);
      ctx.fill();
      // Launcher circle
      ctx.beginPath();
      ctx.arc(THROWER_X, THROWER_Y - 10, THROWER_RADIUS, 0, Math.PI * 2);
      ctx.fillStyle = '#7c3aed';
      ctx.fill();
      ctx.strokeStyle = '#c084fc';
      ctx.lineWidth = 2;
      ctx.stroke();
      // Center dot
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(THROWER_X, THROWER_Y - 10, 4, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    function computeTrajectory(startX, startY, vx, vy, maxBounces) {
      const points = [{ x: startX, y: startY, bounceIndex: 0 }];
      let x = startX, y = startY;
      let bounceCount = 0;
      const STEP = 4;
      const initialSpeed = Math.hypot(vx, vy);
      if (initialSpeed === 0) return points;
      let dvx = vx / initialSpeed;
      let dvy = vy / initialSpeed;
      let simSpeed = initialSpeed;
      const maxPoints = 3000;

      for (let i = 0; i < maxPoints && bounceCount <= maxBounces && simSpeed >= BALL_MIN_SPEED; i++) {
        x += dvx * STEP;
        y += dvy * STEP;

        const wInner = WALL_THICKNESS / 2;
        let bounced = false;
        if (x - BALL_RADIUS < wInner) {
          dvx = Math.abs(dvx);
          x = wInner + BALL_RADIUS;
          bounceCount++;
          bounced = true;
        } else if (x + BALL_RADIUS > W - wInner) {
          dvx = -Math.abs(dvx);
          x = W - wInner - BALL_RADIUS;
          bounceCount++;
          bounced = true;
        }
        if (y - BALL_RADIUS < wInner) {
          dvy = Math.abs(dvy);
          y = wInner + BALL_RADIUS;
          if (!bounced) bounceCount++;
          bounced = true;
        } else if (y + BALL_RADIUS > H - wInner) {
          dvy = -Math.abs(dvy);
          y = H - wInner - BALL_RADIUS;
          if (!bounced) bounceCount++;
          bounced = true;
        }

        if (bounced) simSpeed *= bounceCount <= 3 ? BALL_DECAY_EARLY : BALL_DECAY_LATE;
        if (bounceCount > maxBounces || simSpeed < BALL_MIN_SPEED) break;
        points.push({ x, y, bounceIndex: bounceCount, isBounce: bounced });
      }
      return points;
    }

    function drawAimGuide() {
      if (!drag || !dragCurrent) return;
      const dx = drag.x - dragCurrent.x;
      const dy = drag.y - dragCurrent.y;
      const m = Math.sqrt(dx * dx + dy * dy);
      if (m < BALL_MIN_DRAG) return;

      const clampedM = Math.min(m, BALL_MAX_DRAG);
      const speed = (clampedM / BALL_MAX_DRAG) * BALL_MAX_SPEED;
      const vx = (dx / m) * speed;
      const vy = (dy / m) * speed;

      const startX = THROWER_X;
      const startY = THROWER_Y - 10;
      const trajectory = computeTrajectory(startX, startY, vx, vy, GUIDE_MAX_BOUNCES);

      const segmentOpacities = [0.8, 0.5, 0.25, 0.1];
      const segColors = ['rgba(74,222,128,','rgba(56,189,248,','rgba(167,139,250,','rgba(244,114,182,','rgba(251,146,60,'];
      const bouncePoints = [];

      ctx.save();
      ctx.lineWidth = 2;
      ctx.setLineDash([8, 6]);
      ctx.lineDashOffset = guideDashOffset;

      // Draw segments between bounce points
      let segStart = 0;
      for (let i = 1; i < trajectory.length; i++) {
        const pt = trajectory[i];
        if (pt.isBounce || i === trajectory.length - 1) {
          const segIdx = trajectory[segStart].bounceIndex;
          const opacity = segmentOpacities[Math.min(segIdx, segmentOpacities.length - 1)];
          ctx.strokeStyle = segColors[Math.min(segIdx, segColors.length - 1)] + opacity + ')';
          ctx.beginPath();
          ctx.moveTo(trajectory[segStart].x, trajectory[segStart].y);
          for (let j = segStart + 1; j <= i; j++) {
            ctx.lineTo(trajectory[j].x, trajectory[j].y);
          }
          ctx.stroke();
          if (pt.isBounce) {
            bouncePoints.push({ x: pt.x, y: pt.y, bounceIndex: pt.bounceIndex });
          }
          segStart = i;
        }
      }

      // Draw bounce point circles
      ctx.setLineDash([]);
      for (const bp of bouncePoints) {
        const segIdx = bp.bounceIndex - 1;
        const opacity = segmentOpacities[Math.min(segIdx, segmentOpacities.length - 1)];
        ctx.strokeStyle = segColors[Math.min(segIdx, segColors.length - 1)] + opacity + ')';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.arc(bp.x, bp.y, 4, 0, Math.PI * 2);
        ctx.stroke();
      }

      ctx.restore();
    }

    function drawHUD() {
      ctx.save();
      ctx.font = 'bold 18px "Segoe UI", system-ui, sans-serif';
      ctx.textBaseline = 'top';

      // Shadow
      ctx.fillStyle = 'rgba(0,0,0,0.6)';
      ctx.fillText(`Score: ${score}`, 17, 17);
      ctx.fillText(`Balls: ${ballsRemaining}`, 17, 43);

      // Score text - golden with glow
      ctx.shadowBlur = 6;
      ctx.shadowColor = '#ffd700';
      ctx.fillStyle = '#ffd700';
      ctx.fillText(`Score: ${score}`, 16, 16);
      ctx.shadowBlur = 0;

      ctx.fillStyle = ballsRemaining <= 1 ? '#f87171' : '#a3e635';
      ctx.fillText(`Balls: ${ballsRemaining}`, 16, 42);

      ctx.restore();
    }

    function drawGameOver() {
      // Overlay
      ctx.fillStyle = 'rgba(0, 0, 0, 0.72)';
      ctx.fillRect(0, 0, W, H);

      ctx.save();
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';

      // Title
      ctx.font = 'bold 48px "Segoe UI", system-ui, sans-serif';
      ctx.fillStyle = '#f87171';
      ctx.fillText('Game Over', W / 2, H / 2 - 60);

      // Score
      ctx.font = 'bold 32px "Segoe UI", system-ui, sans-serif';
      ctx.fillStyle = '#fde68a';
      ctx.fillText(`Score: ${score}`, W / 2, H / 2 - 5);

      // Restart hint
      ctx.font = '20px "Segoe UI", system-ui, sans-serif';
      ctx.fillStyle = '#a0a0b0';
      ctx.fillText('Press R to restart', W / 2, H / 2 + 45);

      ctx.font = '18px "Segoe UI", system-ui, sans-serif';
      ctx.fillStyle = '#a0a0b0';
      ctx.fillText('M · Esc — Main Menu', W / 2, H / 2 + 80);

      ctx.restore();
    }

    // ─── Menu Helpers ─────────────────────────────────────────────────────────

    function handleMenuSelect(index) {
      initAudio();
      if (index === 0) {
        resetGame();
        currentState = GameState.PLAYING;
      } else if (index === 1) {
        currentState = GameState.SETTINGS;
        backHover = false;
      } else if (index === 2) {
        currentState = GameState.GUIDE;
        backHover = false;
      }
    }

    function toggleMute() {
      isMuted = !isMuted;
      localStorage.setItem('catnip_muted', JSON.stringify(isMuted));
      if (masterGain) masterGain.gain.value = isMuted ? 0 : 1;
      buildMenuButtons(); // refresh label: Mute ↔ Unmute
    }

    function drawBackButton(hover) {
      const btn = backButtonRect;
      ctx.save();
      ctx.shadowBlur = hover ? 18 : 0;
      ctx.shadowColor = '#6366f1';
      ctx.fillStyle = hover ? 'rgba(99,102,241,0.28)' : 'rgba(255,255,255,0.04)';
      ctx.beginPath();
      ctx.roundRect(btn.x, btn.y, btn.w, btn.h, 10);
      ctx.fill();
      ctx.strokeStyle = hover ? '#818cf8' : 'rgba(255,255,255,0.12)';
      ctx.lineWidth = hover ? 2 : 1;
      ctx.stroke();
      ctx.restore();
      ctx.save();
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.font = '18px "Segoe UI", system-ui, sans-serif';
      ctx.fillStyle = hover ? '#e0e7ff' : '#c8c8d8';
      ctx.fillText('← Back', btn.x + btn.w / 2, btn.y + btn.h / 2);
      ctx.restore();
    }

    function drawMuteButton() {
      const { x, y, w, h } = muteBtnRect;
      const cx = x + w / 2;
      const cy = y + h / 2;
      const r = w / 2;

      ctx.save();

      // Background circle
      ctx.beginPath();
      ctx.arc(cx, cy, r, 0, Math.PI * 2);
      ctx.fillStyle = muteBtnHover ? 'rgba(99,102,241,0.38)' : 'rgba(255,255,255,0.07)';
      ctx.shadowBlur = muteBtnHover ? 14 : 0;
      ctx.shadowColor = '#6366f1';
      ctx.fill();
      ctx.strokeStyle = muteBtnHover ? '#818cf8' : 'rgba(255,255,255,0.18)';
      ctx.lineWidth = 1.5;
      ctx.stroke();

      ctx.shadowBlur = 0;
      const iconColor = isMuted ? '#f87171' : '#c8d8ff';
      ctx.fillStyle = iconColor;
      ctx.strokeStyle = iconColor;
      ctx.lineWidth = 1.5;

      // Speaker body trapezoid (centered on cx, cy)
      const bx = cx - 6;
      const by = cy;
      ctx.beginPath();
      ctx.moveTo(bx - 4, by - 4);
      ctx.lineTo(bx,     by - 4);
      ctx.lineTo(bx + 5, by - 8);
      ctx.lineTo(bx + 5, by + 8);
      ctx.lineTo(bx,     by + 4);
      ctx.lineTo(bx - 4, by + 4);
      ctx.closePath();
      ctx.fill();

      if (!isMuted) {
        // Two sound arcs
        ctx.beginPath();
        ctx.arc(bx + 5, by, 6, -Math.PI * 0.45, Math.PI * 0.45);
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(bx + 5, by, 10, -Math.PI * 0.4, Math.PI * 0.4);
        ctx.stroke();
      } else {
        // X strike-through
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(bx + 7, by - 5);
        ctx.lineTo(bx + 13, by + 5);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(bx + 13, by - 5);
        ctx.lineTo(bx + 7, by + 5);
        ctx.stroke();
      }

      ctx.restore();
    }

    function drawMenu(now) {
      drawBackground(now);

      ctx.save();
      ctx.textAlign = 'center';

      // Title
      ctx.font = 'bold 64px "Segoe UI", system-ui, sans-serif';
      ctx.shadowBlur = 36;
      ctx.shadowColor = `hsl(${(now * 0.05) % 360}, 90%, 65%)`;
      ctx.fillStyle = '#ffd700';
      ctx.textBaseline = 'middle';
      ctx.fillText('CATNIP', W / 2, H / 2 - 175);

      // Subtitle
      ctx.shadowBlur = 0;
      ctx.font = '16px "Segoe UI", system-ui, sans-serif';
      ctx.fillStyle = '#a0a0b0';
      ctx.fillText("don't miss.", W / 2, H / 2 - 130);

      ctx.restore();

      // Draw each button
      for (const btn of menuButtons) {
        const isActive = btn.index === menuHoverIndex || btn.index === menuFocusIndex;
        // Background
        ctx.save();
        ctx.shadowBlur = isActive ? 22 : 0;
        ctx.shadowColor = '#6366f1';
        ctx.fillStyle = isActive ? 'rgba(99,102,241,0.28)' : 'rgba(255,255,255,0.04)';
        ctx.beginPath();
        ctx.roundRect(btn.x, btn.y, btn.w, btn.h, 10);
        ctx.fill();
        // Border
        ctx.strokeStyle = isActive ? '#818cf8' : 'rgba(255,255,255,0.12)';
        ctx.lineWidth = isActive ? 2 : 1;
        ctx.stroke();
        ctx.restore();

        // Label
        ctx.save();
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.font = `${isActive ? 'bold' : '500'} 20px "Segoe UI", system-ui, sans-serif`;
        ctx.fillStyle = isActive ? '#e0e7ff' : '#c8c8d8';
        ctx.fillText(btn.label, btn.x + btn.w / 2, btn.y + btn.h / 2);
        ctx.restore();
      }

      // Keyboard hint
      ctx.save();
      ctx.textAlign = 'center';
      ctx.textBaseline = 'bottom';
      ctx.font = '13px "Segoe UI", system-ui, sans-serif';
      ctx.fillStyle = 'rgba(160,160,176,0.45)';
      ctx.fillText('↑ ↓ arrow keys · Enter to select', W / 2, H - 24);
      ctx.restore();
      drawMuteButton();
    }

    function drawSettings(now) {
      drawBackground(now);
      ctx.save();
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';

      ctx.font = 'bold 40px "Segoe UI", system-ui, sans-serif';
      ctx.fillStyle = '#e8e8e8';
      ctx.shadowBlur = 12;
      ctx.shadowColor = '#6366f1';
      ctx.fillText('Settings', W / 2, 120);
      ctx.shadowBlur = 0;

      // Mute toggle row
      const rowY = H / 2 - 20;
      ctx.font = '22px "Segoe UI", system-ui, sans-serif';
      ctx.fillStyle = '#c8c8d8';
      ctx.textAlign = 'left';
      ctx.fillText('Sound', W / 2 - 120, rowY);

      // Toggle pill
      const pillX = W / 2 + 30;
      const pillY = rowY - 14;
      const pillW = 56;
      const pillH = 28;
      ctx.fillStyle = isMuted ? 'rgba(255,255,255,0.1)' : '#6366f1';
      ctx.shadowBlur = isMuted ? 0 : 12;
      ctx.shadowColor = '#818cf8';
      ctx.beginPath();
      ctx.roundRect(pillX, pillY, pillW, pillH, pillH / 2);
      ctx.fill();
      ctx.shadowBlur = 0;
      // Circle
      const circleX = isMuted ? pillX + 14 : pillX + pillW - 14;
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(circleX, pillY + pillH / 2, 10, 0, Math.PI * 2);
      ctx.fill();

      ctx.textAlign = 'left';
      ctx.font = '16px "Segoe UI", system-ui, sans-serif';
      ctx.fillStyle = isMuted ? '#f87171' : '#4ade80';
      ctx.fillText(isMuted ? 'Off' : 'On', pillX + pillW + 12, rowY);

      ctx.restore();
      drawBackButton(backHover);
      drawMuteButton();
    }

    function drawGuide(now) {
      drawBackground(now);
      ctx.save();
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';

      ctx.font = 'bold 40px "Segoe UI", system-ui, sans-serif';
      ctx.fillStyle = '#e8e8e8';
      ctx.shadowBlur = 12;
      ctx.shadowColor = '#6366f1';
      ctx.fillText('How to Play', W / 2, 120);
      ctx.shadowBlur = 0;

      const lines = [
        { icon: '🐱', text: 'A cat bounces around the arena.' },
        { icon: '🎱', text: 'Drag and release to throw a ball at the cat.' },
        { icon: '🏓', text: 'Bounce off walls for bonus points (+1 per wall).' },
        { icon: '🎯', text: 'Hitting the cat gives you 2 extra balls.' },
        { icon: '⚡', text: 'Each hit makes the cat faster — don\'t miss!' },
        { icon: '💀', text: 'Run out of balls and it\'s game over.' },
      ];

      ctx.textAlign = 'left';
      ctx.textBaseline = 'top';
      const startY = 200;
      const lineH = 52;
      for (let i = 0; i < lines.length; i++) {
        const y = startY + i * lineH;
        ctx.font = '22px "Segoe UI", system-ui, sans-serif';
        ctx.fillStyle = '#4ade80';
        ctx.fillText(lines[i].icon, W / 2 - 260, y);
        ctx.fillStyle = '#c8c8d8';
        ctx.fillText(lines[i].text, W / 2 - 220, y);
      }

      ctx.restore();
      drawBackButton(backHover);
      drawMuteButton();
    }

    // ─── Physics ──────────────────────────────────────────────────────────────

    function updateCat(dt) {
      cat.x += cat.vx * dt;
      cat.y += cat.vy * dt;

      const wI = WALL_THICKNESS / 2;
      if (cat.x - cat.r < wI) { cat.vx = Math.abs(cat.vx); cat.x = wI + cat.r; }
      if (cat.x + cat.r > W - wI) { cat.vx = -Math.abs(cat.vx); cat.x = W - wI - cat.r; }
      if (cat.y - cat.r < wI) { cat.vy = Math.abs(cat.vy); cat.y = wI + cat.r; }
      if (cat.y + cat.r > H - wI) { cat.vy = -Math.abs(cat.vy); cat.y = H - wI - cat.r; }

      catHitFlash = Math.max(0, catHitFlash - dt);
    }

    function stepBall(b, dt) {
      b.x += b.vx * dt;
      b.y += b.vy * dt;

      let bounced = false;

      const wJ = WALL_THICKNESS / 2;
      if (b.x - BALL_RADIUS < wJ) {
        b.vx = Math.abs(b.vx);
        b.x = wJ + BALL_RADIUS;
        b.bounces++;
        bounced = true;
      } else if (b.x + BALL_RADIUS > W - wJ) {
        b.vx = -Math.abs(b.vx);
        b.x = W - wJ - BALL_RADIUS;
        b.bounces++;
        bounced = true;
      }

      if (b.y - BALL_RADIUS < wJ) {
        b.vy = Math.abs(b.vy);
        b.y = wJ + BALL_RADIUS;
        if (!bounced) b.bounces++;
        bounced = true;
      } else if (b.y + BALL_RADIUS > H - wJ) {
        b.vy = -Math.abs(b.vy);
        b.y = H - wJ - BALL_RADIUS;
        if (!bounced) b.bounces++;
        bounced = true;
      }

      if (bounced) playBounce();

      // Apply momentum decay once per step if any wall was hit
      if (bounced) {
        const _spd = Math.hypot(b.vx, b.vy);
        if (_spd > 0) {
          const _factor = b.bounces <= 3 ? BALL_DECAY_EARLY : BALL_DECAY_LATE;
          const _d = _spd * _factor;
          b.vx = (b.vx / _spd) * _d;
          b.vy = (b.vy / _spd) * _d;
        }
      }
    }

    function updateBalls(dt) {
      activeBalls = activeBalls.filter(b => Math.hypot(b.vx, b.vy) >= BALL_MIN_SPEED);

      for (const b of activeBalls) {
        // Record trail position before moving (max 8 positions)
        if (!b.trail) b.trail = [];
        b.trail.push({ x: b.x, y: b.y });
        if (b.trail.length > 8) b.trail.shift();

        const speed = Math.sqrt(b.vx * b.vx + b.vy * b.vy);
        const displacement = speed * dt;
        // Sub-step if displacement exceeds ball radius to prevent tunneling
        const steps = displacement > BALL_RADIUS ? 2 : 1;
        const subDt = dt / steps;
        for (let s = 0; s < steps; s++) {
          if (Math.hypot(b.vx, b.vy) < BALL_MIN_SPEED) break;
          stepBall(b, subDt);
        }
      }

      // Remove expired balls
      activeBalls = activeBalls.filter(b => Math.hypot(b.vx, b.vy) >= BALL_MIN_SPEED);
    }

    function checkCollisions() {
      const toRemove = [];
      for (let i = 0; i < activeBalls.length; i++) {
        const b = activeBalls[i];
        const dx = b.x - cat.x;
        const dy = b.y - cat.y;
        const dist2 = dx * dx + dy * dy;
        const radSum = cat.r + BALL_RADIUS;
        if (dist2 <= radSum * radSum) {
          toRemove.push(i);
          const earned = 1 + b.bounces;
          score += earned;
          ballsRemaining += BALLS_PER_HIT;
          catHitFlash = 0.3;
          screenShake = 8;
          spawnHitParticles(cat.x, cat.y);
          playCatHit(b.bounces);
          cat.speed = Math.min(cat.speed * CAT_SPEED_MULTIPLIER, CAT_MAX_SPEED);
          // Rescale velocity to new speed preserving direction
          const curSpeed = Math.sqrt(cat.vx * cat.vx + cat.vy * cat.vy);
          if (curSpeed > 0) {
            cat.vx = (cat.vx / curSpeed) * cat.speed;
            cat.vy = (cat.vy / curSpeed) * cat.speed;
          }
          // Combo popup for wall-bounce scoring
          if (b.bounces > 0) {
            const wallWord = b.bounces === 1 ? 'WALL' : 'WALLS';
            comboPopups.push({
              text: `${b.bounces}× ${wallWord}!`,
              subtext: `+${earned}`,
              x: b.x,
              y: b.y - 20,
              age: 0,
              lifetime: 100,
              bounces: b.bounces,
            });
          }
        }
      }
      // Remove hit balls (in reverse to preserve indices)
      for (let i = toRemove.length - 1; i >= 0; i--) {
        activeBalls.splice(toRemove[i], 1);
      }
    }

    function updateComboPopups(dt) {
      for (let i = comboPopups.length - 1; i >= 0; i--) {
        const p = comboPopups[i];
        p.age++;
        p.y -= 1.8;
        if (p.age >= p.lifetime) comboPopups.splice(i, 1);
      }
    }

    function drawComboPopups() {
      for (const p of comboPopups) {
        const frac = p.age / p.lifetime;
        const opacity = Math.max(0, 1 - frac);

        // Dramatic punch-in scale: overshoot in first 10% then settle
        let entryScale = 1;
        if (frac < 0.08) {
          // scale from 2 → 1.15 during punch-in
          entryScale = 2 - (frac / 0.08) * 0.85;
        } else if (frac < 0.18) {
          // settle back 1.15 → 1.0
          entryScale = 1.15 - ((frac - 0.08) / 0.1) * 0.15;
        }

        const baseScale = 0.85 + p.bounces * 0.18;
        const fontSize = Math.round(28 * baseScale * entryScale);

        ctx.save();
        ctx.globalAlpha = opacity;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.lineJoin = 'round';

        // Stronger glow for high combos
        const isHighCombo = p.bounces >= 3;
        ctx.shadowBlur = isHighCombo ? 28 : 18;
        ctx.shadowColor = isHighCombo ? '#f97316' : '#facc15';

        // Main text with outline
        ctx.font = `bold ${fontSize}px Impact, Arial, sans-serif`;
        ctx.lineWidth = 5;
        ctx.strokeStyle = 'rgba(0,0,0,0.9)';
        ctx.strokeText(p.text, p.x, p.y);
        ctx.fillStyle = isHighCombo ? '#fb923c' : '#fde047';
        ctx.fillText(p.text, p.x, p.y);

        // Sub-text (score gained)
        ctx.shadowBlur = 8;
        const subSize = Math.round(fontSize * 0.58);
        ctx.font = `bold ${subSize}px Arial, sans-serif`;
        ctx.lineWidth = 3;
        ctx.strokeStyle = 'rgba(0,0,0,0.85)';
        ctx.strokeText(p.subtext, p.x, p.y + fontSize * 0.88);
        ctx.fillStyle = '#ffffff';
        ctx.fillText(p.subtext, p.x, p.y + fontSize * 0.88);

        ctx.restore();
      }
    }

    function drawParticles() {
      for (const p of particles) {
        const frac = 1 - p.age / p.lifetime;
        ctx.save();
        ctx.globalAlpha = frac * 0.9;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r * frac, 0, Math.PI * 2);
        ctx.fillStyle = p.color;
        ctx.shadowBlur = 8;
        ctx.shadowColor = p.color;
        ctx.fill();
        ctx.restore();
      }
    }

    function spawnHitParticles(x, y) {
      const HIT_COLORS = [
        '#ff4d4d','#ff9a3c','#ffe94d','#a3e635','#4ade80',
        '#22d3ee','#818cf8','#e879f9','#f472b6','#ffffff'
      ];
      const count = 18;
      for (let i = 0; i < count; i++) {
        const angle = (Math.PI * 2 * i) / count + randomRange(-0.3, 0.3);
        const speed = randomRange(80, 220);
        particles.push({
          x,
          y,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          r: randomRange(4, 9),
          age: 0,
          lifetime: randomRange(28, 48),
          color: HIT_COLORS[Math.floor(Math.random() * HIT_COLORS.length)],
        });
      }
    }

    function updateParticles(dt) {
      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.age++;
        p.x += p.vx * dt;
        p.y += p.vy * dt;
        p.vy += 60 * dt; // gentle gravity pull
        if (p.age >= p.lifetime) particles.splice(i, 1);
      }
    }

    function drawBackground(now) {
      // Dark fill (deep navy)
      ctx.fillStyle = '#050510';
      ctx.fillRect(0, 0, W, H);

      // Radial gradient vignette from center (richer purple/blue/teal)
      const grd = ctx.createRadialGradient(W / 2, H / 2, 0, W / 2, H / 2, Math.max(W, H) * 0.72);
      grd.addColorStop(0, 'rgba(40, 10, 80, 0.4)');
      grd.addColorStop(1, 'rgba(0, 20, 40, 0.0)');
      ctx.fillStyle = grd;
      ctx.fillRect(0, 0, W, H);

      // Third subtle radial gradient (off-center, bottom-right)
      const grd2 = ctx.createRadialGradient(W * 0.75, H * 0.75, 0, W * 0.75, H * 0.75, Math.max(W, H) * 0.5);
      grd2.addColorStop(0, 'rgba(0, 50, 60, 0.2)');
      grd2.addColorStop(1, 'rgba(0, 50, 60, 0)');
      ctx.fillStyle = grd2;
      ctx.fillRect(0, 0, W, H);

      // Twinkling colorful star field
      const t = now * 0.001;
      for (const s of stars) {
        const alpha = 0.15 + 0.25 * (0.5 + 0.5 * Math.sin(s.phase + t * s.speed));
        ctx.save();
        ctx.globalAlpha = alpha;
        ctx.fillStyle = s.color;
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }

      // Subtle stylized grid (subtle purple tint)
      ctx.strokeStyle = 'rgba(100, 80, 180, 0.035)';
      ctx.lineWidth = 1;
      for (let gx = 0; gx <= W; gx += 50) {
        ctx.beginPath(); ctx.moveTo(gx, 0); ctx.lineTo(gx, H); ctx.stroke();
      }
      for (let gy = 0; gy <= H; gy += 50) {
        ctx.beginPath(); ctx.moveTo(0, gy); ctx.lineTo(W, gy); ctx.stroke();
      }
    }

    function drawWalls(now) {
      const pulse = 0.55 + 0.18 * Math.sin(now * 0.0018);
      const hue = (now * 0.05) % 360;
      ctx.save();
      ctx.shadowBlur = 18;
      ctx.shadowColor = `hsla(${hue}, 85%, 55%, ${pulse})`;
      ctx.strokeStyle = `hsla(${hue}, 90%, 70%, ${pulse + 0.15})`;
      ctx.lineWidth = WALL_THICKNESS;
      ctx.lineJoin = 'miter';
      ctx.strokeRect(
        WALL_THICKNESS / 2,
        WALL_THICKNESS / 2,
        W - WALL_THICKNESS,
        H - WALL_THICKNESS
      );
      // Corner accent dots (offset hue for contrast)
      ctx.shadowBlur = 24;
      ctx.fillStyle = `hsla(${(hue + 60) % 360}, 90%, 75%, ${pulse + 0.2})`;
      for (const [cx, cy] of [[0, 0], [W, 0], [0, H], [W, H]]) {
        ctx.beginPath();
        ctx.arc(cx, cy, 5, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();
    }

    // ─── Audio ───────────────────────────────────────────────────────────────

    function initAudio() {
      if (audioCtx) return;
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      audioCtx.resume();
      masterGain = audioCtx.createGain();
      masterGain.gain.value = isMuted ? 0 : 1;
      masterGain.connect(audioCtx.destination);
    }

    function playLaunch() {
      if (!audioCtx) return;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(400, audioCtx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(150, audioCtx.currentTime + 0.15);
      gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.15);
      osc.connect(gain); gain.connect(masterGain);
      osc.start(); osc.stop(audioCtx.currentTime + 0.15);
    }

    function playBounce() {
      if (!audioCtx) return;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(300, audioCtx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(150, audioCtx.currentTime + 0.05);
      gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.05);
      osc.connect(gain); gain.connect(masterGain);
      osc.start(); osc.stop(audioCtx.currentTime + 0.05);
    }

    function playCatHit(bounces) {
      if (!audioCtx) return;
      const pitch = 200 + bounces * 50;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(pitch, audioCtx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(pitch * 0.5, audioCtx.currentTime + 0.2);
      gain.gain.setValueAtTime(0.4, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
      osc.connect(gain); gain.connect(masterGain);
      osc.start(); osc.stop(audioCtx.currentTime + 0.3);
    }

    function playGameOver() {
      if (!audioCtx) return;
      [400, 300, 200, 100].forEach((freq, i) => {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        const t = audioCtx.currentTime + i * 0.15;
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(freq, t);
        gain.gain.setValueAtTime(0.3, t);
        gain.gain.exponentialRampToValueAtTime(0.01, t + 0.1);
        osc.connect(gain); gain.connect(masterGain);
        osc.start(t); osc.stop(t + 0.15);
      });
    }

    // ─── Input ────────────────────────────────────────────────────────────────

    canvas.addEventListener('pointerdown', (e) => {
      initAudio();
      if (currentState !== GameState.PLAYING) {
        return; // handled on pointerup for menus
      }
      if (gameOver) return;
      const rect = canvas.getBoundingClientRect();
      drag = {
        x: (e.clientX - rect.left),
        y: (e.clientY - rect.top),
      };
      dragCurrent = { ...drag };
      canvas.setPointerCapture(e.pointerId);
    });

    canvas.addEventListener('pointermove', (e) => {
      // always track mute button hover regardless of state
      const _r = canvas.getBoundingClientRect();
      const _mx = e.clientX - _r.left;
      const _my = e.clientY - _r.top;
      const mb = muteBtnRect;
      muteBtnHover = _mx >= mb.x && _mx <= mb.x + mb.w && _my >= mb.y && _my <= mb.y + mb.h;

      if (currentState === GameState.MENU || currentState === GameState.SETTINGS || currentState === GameState.GUIDE) {
        const rect = canvas.getBoundingClientRect();
        const mx = e.clientX - rect.left;
        const my = e.clientY - rect.top;
        if (currentState === GameState.MENU) {
          menuHoverIndex = -1;
          for (const btn of menuButtons) {
            if (mx >= btn.x && mx <= btn.x + btn.w && my >= btn.y && my <= btn.y + btn.h) {
              menuHoverIndex = btn.index;
              break;
            }
          }
        } else {
          const b = backButtonRect;
          backHover = mx >= b.x && mx <= b.x + b.w && my >= b.y && my <= b.y + b.h;
        }
        return;
      }
      if (!drag) return;
      const rect = canvas.getBoundingClientRect();
      dragCurrent = {
        x: (e.clientX - rect.left),
        y: (e.clientY - rect.top),
      };
    });

    canvas.addEventListener('pointerup', (e) => {
      // Mute button click — all states
      {
        const _r = canvas.getBoundingClientRect();
        const _mx = e.clientX - _r.left;
        const _my = e.clientY - _r.top;
        const mb = muteBtnRect;
        if (_mx >= mb.x && _mx <= mb.x + mb.w && _my >= mb.y && _my <= mb.y + mb.h) {
          initAudio();
          toggleMute();
          return;
        }
      }

      if (currentState === GameState.MENU) {
        const rect = canvas.getBoundingClientRect();
        const mx = e.clientX - rect.left;
        const my = e.clientY - rect.top;
        for (const btn of menuButtons) {
          if (mx >= btn.x && mx <= btn.x + btn.w && my >= btn.y && my <= btn.y + btn.h) {
            handleMenuSelect(btn.index);
            return;
          }
        }
        return;
      }
      if (currentState === GameState.SETTINGS || currentState === GameState.GUIDE) {
        const rect = canvas.getBoundingClientRect();
        const mx = e.clientX - rect.left;
        const my = e.clientY - rect.top;
        const b = backButtonRect;
        if (mx >= b.x && mx <= b.x + b.w && my >= b.y && my <= b.y + b.h) {
          currentState = GameState.MENU;
          backHover = false;
          buildMenuButtons();
        }
        if (currentState === GameState.SETTINGS) {
          // click the mute toggle pill
          const pillX = W / 2 + 30;
          const pillY = H / 2 - 34;
          const pillW = 56;
          const pillH = 28;
          if (mx >= pillX && mx <= pillX + pillW && my >= pillY && my <= pillY + pillH) {
            toggleMute();
          }
        }
        return;
      }
      if (gameOver) {
        resetGame();
        drag = null;
        dragCurrent = null;
        return;
      }
      if (!drag) return;
      const rect = canvas.getBoundingClientRect();
      const upX = (e.clientX - rect.left);
      const upY = (e.clientY - rect.top);

      const dx = drag.x - upX;
      const dy = drag.y - upY;
      const m = Math.sqrt(dx * dx + dy * dy);

      if (m >= BALL_MIN_DRAG && ballsRemaining > 0) {
        const clampedM = Math.min(m, BALL_MAX_DRAG);
        const speed = (clampedM / BALL_MAX_DRAG) * BALL_MAX_SPEED;
        activeBalls.push({
          x: THROWER_X,
          y: THROWER_Y - 10,
          vx: (dx / m) * speed,
          vy: (dy / m) * speed,
          bounces: 0,
        });
        ballsRemaining--;
        playLaunch();
      }

      drag = null;
      dragCurrent = null;
    });

    canvas.addEventListener('pointercancel', () => {
      drag = null;
      dragCurrent = null;
    });

    canvas.addEventListener('pointerleave', () => {
      muteBtnHover = false;
      menuHoverIndex = -1;
      backHover = false;
    });

    document.addEventListener('keydown', (e) => {
      initAudio();
      if (currentState === GameState.MENU) {
        if (e.key === 'ArrowDown') {
          menuFocusIndex = (menuFocusIndex + 1) % menuButtons.length;
          e.preventDefault();
        } else if (e.key === 'ArrowUp') {
          menuFocusIndex = (menuFocusIndex - 1 + menuButtons.length) % menuButtons.length;
          e.preventDefault();
        } else if (e.key === 'Enter' || e.key === ' ') {
          handleMenuSelect(menuFocusIndex);
          e.preventDefault();
        }
        return;
      }
      if (currentState === GameState.SETTINGS || currentState === GameState.GUIDE) {
        if (e.key === 'Escape' || e.key === 'Backspace') {
          currentState = GameState.MENU;
          backHover = false;
          buildMenuButtons();
        }
        return;
      }
      // PLAYING state
      if (e.key === 'Escape') {
        currentState = GameState.MENU;
        menuFocusIndex = 0;
        menuHoverIndex = -1;
        buildMenuButtons();
        return;
      }
      if (e.key === 'r' || e.key === 'R') {
        resetGame();
      }
      if ((e.key === 'm' || e.key === 'M') && gameOver) {
        currentState = GameState.MENU;
        menuFocusIndex = 0;
        menuHoverIndex = -1;
        buildMenuButtons();
      }
    });

    // ─── Game Loop ────────────────────────────────────────────────────────────

    let lastTime = null;

    function frame(now) {
      if (lastTime === null) lastTime = now;
      const dtMs = Math.min(now - lastTime, 33);
      const dt = dtMs / 1000;
      lastTime = now;

      if (currentState === GameState.MENU) {
        drawMenu(now);
        requestAnimationFrame(frame);
        return;
      }
      if (currentState === GameState.SETTINGS) {
        drawSettings(now);
        requestAnimationFrame(frame);
        return;
      }
      if (currentState === GameState.GUIDE) {
        drawGuide(now);
        requestAnimationFrame(frame);
        return;
      }

      // --- PLAYING state below ---
      guideDashOffset -= 1;

      if (!gameOver) {
        updateCat(dt);
        updateBalls(dt);
        checkCollisions();
        updateComboPopups(dt);
        updateParticles(dt);

        // Decay screen shake
        if (screenShake > 0.2) {
          screenShake *= 0.82;
        } else {
          screenShake = 0;
        }

        // Check lose condition
        if (ballsRemaining === 0 && activeBalls.length === 0) {
          gameOver = true;
          playGameOver();
        }
      }

      // Background (clears canvas internally)
      drawBackground(now);

      // Apply screen shake transform for world rendering
      ctx.save();
      if (screenShake > 0) {
        ctx.translate(
          randomRange(-screenShake, screenShake),
          randomRange(-screenShake, screenShake)
        );
      }

      // Draw world
      drawWalls(now);
      drawThrower();
      drawAimGuide();
      for (const b of activeBalls) drawBall(b);
      drawCat(cat);
      drawParticles();
      drawComboPopups();

      ctx.restore();

      // HUD always drawn without shake
      drawHUD();
      drawMuteButton();

      if (gameOver) drawGameOver();

      requestAnimationFrame(frame);
    }

    // ─── Boot ─────────────────────────────────────────────────────────────────
    buildMenuButtons();
    resetGame();
    requestAnimationFrame(frame);
  </script>
</body>
</html>
